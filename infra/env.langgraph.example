# New environment variables introduced by the LangGraph modernisation.
# Append this block to your .env.example (and set real values in your .env).
# Every var is optional — the app runs without any of them, just with less
# observability.

# ── LangSmith (hosted tracing) ────────────────────────────────────────────
# Get keys at https://smith.langchain.com/settings
# LANGCHAIN_TRACING_V2=true                       # opt-in; defaults to off
# LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
# LANGCHAIN_API_KEY=lsv2_pt_...
# LANGCHAIN_PROJECT=home-asset-agent-dev          # per-env project name

# ── Langfuse (self-hostable alternative) ──────────────────────────────────
# Start the local stack: docker compose -f infra/langfuse-compose.yaml up -d
# UI at http://localhost:3001; create a project and copy the keys below.
# LANGFUSE_ENABLED=false                          # flip to true to activate
# LANGFUSE_HOST=http://localhost:3001
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...

# ── Structured logging ────────────────────────────────────────────────────
# APP_ENV=dev                                     # dev = coloured console, prod = JSON
# LOG_LEVEL=INFO                                  # DEBUG | INFO | WARNING | ERROR
# APP_VERSION=0.4.0                               # stamped into audit events

# ── Real-time alerts ──────────────────────────────────────────────────────
# ALERT_MIN_SEVERITY=error                        # info | warning | error | critical
# DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/...
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/...

# ── Semantic memory (pgvector-backed RAG) ─────────────────────────────────
# Required for real RAG retrieval; without it, retrieval degrades to a
# deterministic hash stub — loudly logged (stderr banner + structured log),
# not silently. Every specialist auto-retrieves via agent.yaml:retrieve_semantic.
# Also requires the `pgvector` Postgres extension on your DATABASE_URL /
# Supabase project — ensure_schema() creates it for you if your DB role can.
# VOYAGE_API_KEY=pa-...

# ── CI-only secrets (GitHub Actions repo secrets, not local .env) ─────────
# Used by .github/workflows/eval-nightly.yml to run eval/run_eval.py against
# a real, seeded database — not needed for local dev unless you're running
# the eval yourself. See eval/scenarios.json for what the seed data must contain.
# EVAL_DATABASE_URL=postgresql://...
