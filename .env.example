# ── Database provider ─────────────────────────────────────────────────────────
# Switch between backends by changing DB_PROVIDER. All other settings for the
# inactive provider are ignored at runtime.
DB_PROVIDER=neon          # or: supabase

# ── Neon / standard PostgreSQL (used when DB_PROVIDER=neon) ──────────────────
DATABASE_URL=postgresql://neondb_owner:<password>@<host>.neon.tech/<dbname>?sslmode=require

# ── Supabase (used when DB_PROVIDER=supabase) ─────────────────────────────────
SUPABASE_URL=https://<your-project-ref>.supabase.co
SUPABASE_KEY=<your-service-role-key>
# Auto-schema creation over a direct Postgres connection (optional).
# Provide ONE of the two below, or paste the schema SQL into the Supabase editor manually.
# SUPABASE_DB_URL=postgresql://postgres:<pw>@db.<ref>.supabase.co:5432/postgres
# SUPABASE_DB_PASSWORD=<your-database-password>

# ── Admin bootstrap ───────────────────────────────────────────────────────────
# Created automatically on first run when no users exist.
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=<choose-a-strong-password>

# ── LLM provider ──────────────────────────────────────────────────────────────
# LLM_PROVIDER=claude_cli    # default — needs claude CLI authenticated
# LLM_PROVIDER=claude_sdk
# ANTHROPIC_API_KEY=sk-ant-...

# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-...

# ── Optional integrations ─────────────────────────────────────────────────────
# TELEGRAM_BOT_TOKEN=...
# TELEGRAM_CHAT_ID=...
